<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StudySync.ViewModels"
             x:Class="StudySync.Views.StatisticsPage"
             x:DataType="vm:StatisticsViewModel"
             Title="Productivity Analytics">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="20">

            <!-- Study Totals Card -->
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Study Time Overview" Style="{StaticResource HeaderLabel}" />

                    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                            <Label Text="Today" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            <Label Text="{Binding DailyHours, StringFormat='{0:F1}h'}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                            <Label Text="This Week" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            <Label Text="{Binding WeeklyHours, StringFormat='{0:F1}h'}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                            <Label Text="This Month" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            <Label Text="{Binding MonthlyHours, StringFormat='{0:F1}h'}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Daily Study Hours Breakdown -->
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Past 7 Days Study Hours" Style="{StaticResource HeaderLabel}" />

                    <CollectionView ItemsSource="{Binding WeeklyTrend}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:DailyTrendItem">
                                <Grid ColumnDefinitions="50, *, 50" Margin="0,4" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding DayName}" Style="{StaticResource BodyLabel}" VerticalOptions="Center" />
                                    <ProgressBar Grid.Column="1" Progress="{Binding Hours, Converter={StaticResource InverseBoolConverter}, ConverterParameter=ScaleDiv10}"
                                                 ProgressColor="{StaticResource Primary}" VerticalOptions="Center" HeightRequest="10" />
                                    <Label Grid.Column="2" Text="{Binding Hours, StringFormat='{0:F1}h'}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="End" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Metrics Summary Grid -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="12" RowDefinitions="Auto, Auto" RowSpacing="12">
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Productivity Rate" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        <Label Text="{Binding ProductivityPercentage, StringFormat='{0:F0}%'}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Success}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Current Streak" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        <Label Text="{Binding StudyStreak, StringFormat='🔥 {0} Days'}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Warning}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Avg Session Length" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        <Label Text="{Binding AvgSessionLength, StringFormat='{0:F0} min'}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Assignments Done" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        <Label Text="{Binding CompletedAssignments, StringFormat='{0}'}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Info}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
