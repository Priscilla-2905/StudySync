<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StudySync.ViewModels"
             xmlns:models="clr-namespace:StudySync.Models"
             x:Class="StudySync.Views.TodoPage"
             x:DataType="vm:TodoViewModel"
             Title="Daily To-Do List">

    <Grid RowDefinitions="Auto, Auto, *" Padding="16" RowSpacing="14">

        <!-- Completion Progress Card -->
        <Border Grid.Row="0" Style="{StaticResource CardFrame}" Padding="16">
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0" Text="Today's Progress" Style="{StaticResource HeaderLabel}" />
                    <Label Grid.Column="1" Text="{Binding ProgressText}" FontSize="13" TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                </Grid>
                <ProgressBar Progress="{Binding CompletionProgress}" ProgressColor="{StaticResource Primary}" HeightRequest="8" />
            </VerticalStackLayout>
        </Border>

        <!-- New Task Input Row -->
        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" ColumnSpacing="10">
            <Entry Grid.Column="0" Placeholder="Add a manual task..." Text="{Binding NewTodoTitle}" ReturnCommand="{Binding AddTodoCommand}" />
            <Button Grid.Column="1" Text="Add" Style="{StaticResource PrimaryButton}" Command="{Binding AddTodoCommand}" WidthRequest="80" />
        </Grid>

        <!-- Tasks List -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding TodoItems}" SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                    <Label Text="No tasks for today!" Style="{StaticResource HeaderLabel}" HorizontalOptions="Center" />
                    <Label Text="Add a task above or generate your study schedule." Style="{StaticResource SubheaderLabel}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TodoItem">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete" BackgroundColor="#F44336"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TodoViewModel}}, Path=DeleteTodoCommand}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border Style="{StaticResource CardFrame}" Margin="0,0,0,8" Padding="12">
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted}" VerticalOptions="Center"
                                          Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TodoViewModel}}, Path=ToggleCompleteCommand}"
                                          CommandParameter="{Binding .}" />

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Title}" Style="{StaticResource BodyLabel}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>

                                <Border Grid.Column="2" IsVisible="{Binding IsAutoGenerated}" BackgroundColor="#E0E0E0" StrokeShape="RoundRectangle 4" Padding="6,2" VerticalOptions="Center">
                                    <Label Text="Auto" FontSize="10" TextColor="#666" />
                                </Border>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
