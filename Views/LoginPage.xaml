<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StudySync.ViewModels"
             x:Class="StudySync.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False">

    <ScrollView ContentPage.IgnoreSafeArea="True">
        <Grid RowDefinitions="Auto, *">

            <!-- Top Header Banner -->
            <BoxView Grid.Row="0" HeightRequest="220" Color="{StaticResource Primary}" />

            <VStackLayout Grid.Row="0" Margin="24,60,24,0" Spacing="8" HorizontalOptions="Center">
                <Label Text="StudySync" FontSize="36" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                <Label Text="Smart Study Planner" FontSize="16" TextColor="#D1C4E9" HorizontalOptions="Center" />
            </VStackLayout>

            <!-- Login Card -->
            <Border Grid.Row="1" Style="{StaticResource CardFrame}" Margin="24,-40,24,24" VerticalOptions="Start">
                <VStackLayout Spacing="16">

                    <Label Text="Welcome Back" Style="{StaticResource TitleLabel}" HorizontalOptions="Center" Margin="0,8" />

                    <!-- Error Message Banner -->
                    <Border BackgroundColor="#FFEBEE" Stroke="#EF9A9A" StrokeShape="RoundRectangle 8" Padding="12"
                            IsVisible="{Binding ErrorMessage, Converter={StaticResource InverseBoolConverter}, ConverterParameter=EmptyCheck}">
                        <Label Text="{Binding ErrorMessage}" TextColor="#C62828" FontSize="13" />
                    </Border>

                    <!-- Email Field -->
                    <VStackLayout Spacing="4">
                        <Label Text="Email Address" Style="{StaticResource SubheaderLabel}" />
                        <Entry Placeholder="student@university.edu" Keyboard="Email" Text="{Binding Email}" />
                    </VStackLayout>

                    <!-- Password Field -->
                    <VStackLayout Spacing="4">
                        <Label Text="Password" Style="{StaticResource SubheaderLabel}" />
                        <Entry Placeholder="••••••••" IsPassword="True" Text="{Binding Password}" />
                    </VStackLayout>

                    <!-- Remember Me -->
                    <HorizontalStackLayout Spacing="8">
                        <CheckBox IsChecked="{Binding RememberMe}" Color="{StaticResource Primary}" />
                        <Label Text="Remember me on this device" VerticalOptions="Center" Style="{StaticResource BodyLabel}" />
                    </HorizontalStackLayout>

                    <!-- Login Button -->
                    <Button Text="Sign In" Style="{StaticResource PrimaryButton}" Command="{Binding LoginCommand}" Margin="0,12,0,0" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}" HorizontalOptions="Center" />

                    <!-- Register Link -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,16,0,0">
                        <Label Text="Don't have an account?" Style="{StaticResource SubheaderLabel}" />
                        <Label Text="Register" TextColor="{StaticResource Primary}" FontAttributes="Bold" Style="{StaticResource SubheaderLabel}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToRegisterCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                </VStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
