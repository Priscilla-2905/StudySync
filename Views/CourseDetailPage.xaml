<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StudySync.ViewModels"
             x:Class="StudySync.Views.CourseDetailPage"
             x:DataType="vm:CourseDetailViewModel"
             Title="{Binding Title}">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="16">

            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="14">

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Course Code *" Style="{StaticResource SubheaderLabel}" />
                        <Entry Placeholder="e.g. CS101" Text="{Binding CourseCode}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Course Name *" Style="{StaticResource SubheaderLabel}" />
                        <Entry Placeholder="e.g. Data Structures &amp; Algorithms" Text="{Binding CourseName}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Lecturer / Instructor" Style="{StaticResource SubheaderLabel}" />
                        <Entry Placeholder="e.g. Dr. Alan Turing" Text="{Binding Lecturer}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Credit Hours" Style="{StaticResource SubheaderLabel}" />
                        <Entry Text="{Binding Credits}" Keyboard="Numeric" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Course Color Badge" Style="{StaticResource SubheaderLabel}" />
                        <CollectionView ItemsSource="{Binding ColorOptions}" SelectionMode="Single"
                                        SelectedItem="{Binding SelectedColour}">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Horizontal" Span="1" HorizontalItemSpacing="12" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <BoxView WidthRequest="36" HeightRequest="36" CornerRadius="18" Color="{Binding .}" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <Button Text="Save Course" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
